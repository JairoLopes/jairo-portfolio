<file path="app/globals.css">
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

/* =========================================================
   TEMA: "Cosmic Void"
   Paleta espacial inspirada em nebulosas, estrelas distantes
   e poeira cósmica. Este arquivo modifica APENAS cores,
   gradientes de fundo e tokens do design system.
   Toda a camada de animação (blackhole-spin, partículas em
   body::before/after, media queries de movimento) permanece
   inalterada.
   ========================================================= */

@theme {
  /* ── VOID CÓSMICO ─────────────────────────────────────── */
  /* Preto profundo com leve tom violeta — o "nada" do espaço. */
  --color-background: #050014;

  /* Superfícies: vidro estelar translúcido com tinta violeta.
     Mantém transparência para o efeito glassmorphism continuar
     funcionando com o blur. */
  --color-surface: rgba(18, 14, 42, 0.72);
  --color-surface-hover: rgba(28, 22, 58, 0.85);
  --color-surface-active: rgba(40, 32, 80, 0.92);

  /* Bordas: poeira cósmica azulada — quase imperceptível,
     presente o suficiente para dar contorno. */
  --color-border: rgba(150, 165, 240, 0.13);
  --color-border-glow: rgba(140, 180, 255, 0.55);

  /* ── ACENTOS ESTELARES ───────────────────────────────── */
  /* Três temperaturas cósmicas:
     primary  → azul-ciano estelar (luz de estrela classe A)
     glow     → azul-violeta etéreo (halo estelar)
     purple   → violeta de nebulosa (gás interestelar)
     magenta  → rosa de supernova (explosão cósmica) */
  --color-primary: #7dd3fc;
  --color-primary-glow: #a5b4fc;
  --color-accent-purple: #a78bfa;
  --color-accent-magenta: #e879f9;

  /* ── TIPOGRAFIA ──────────────────────────────────────── */
  /* Branco com leve tom azulado — a cor da luz estelar
     filtrada pela atmosfera. */
  --color-foreground: #eef2ff;
  --color-foreground-muted: #a8b0d0;
  --color-foreground-subtle: #6d7594;

  --font-sans: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-geist-mono), ui-monospace, SFMono-Regular, monospace;
}

/*
 * Variáveis CSS mantidas para compatibilidade com classes
 * utilitárias e estilos inline. As que referenciam
 * `var(--color-*)` são atualizadas automaticamente.
 */
:root {
  --surface: var(--color-surface);
  --surface-hover: var(--color-surface-hover);
  --surface-active: var(--color-surface-active);
  --border: oklch(0.922 0 0);
  --border-glow: var(--color-border-glow);

  --primary: oklch(0.205 0 0);
  --primary-glow: var(--color-primary-glow);
  --accent-purple: var(--color-accent-purple);
  --accent-magenta: var(--color-accent-magenta);
  --foreground-muted: var(--color-foreground-muted);
  --foreground-subtle: var(--color-foreground-subtle);

  color-scheme: dark;

  --background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary-foreground: oklch(0.985 0 0);
  --secondary: oklch(0.97 0 0);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --accent: oklch(0.97 0 0);
  --accent-foreground: oklch(0.205 0 0);
  --destructive: oklch(0.577 0.245 27.325);
  --input: oklch(0.922 0 0);
  --ring: oklch(0.708 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --radius: 0.625rem;
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: oklch(0.205 0 0);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.97 0 0);
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.922 0 0);
  --sidebar-ring: oklch(0.708 0 0);
}

/* =========================================================
   BACKGROUND BASE — Void cósmico
   ========================================================= */

html {
  /* Cor sólida de fallback — o "escuro absoluto" do espaço. */
  min-height: 100%;
  background-color: #03000a;

  /* Nota de arquitetura:
     O gradiente radial que antes vivia aqui foi movido para um
     <div> fixo no layout.tsx. Motivo: com
     `background-attachment: fixed`, o browser repintava o
     gradiente a cada frame de scroll, porque o `html` cresce
     com o documento. Movendo para um <div> com `position:
     fixed`, o browser trata como camada isolada e o repaint
     durante a rolagem cai para zero. */

  /* Impede bounce/pull-to-refresh quando suportado. */
  overscroll-behavior-y: none;
}

/* =========================================================
   BODY
   ========================================================= */
body {
  margin: 0;
  /* Fallback amplo para navegadores antigos. svh fornece uma altura estável em mobile. */
  min-height: 100vh;
  min-height: 100svh;
  position: relative;
  /* O fundo real está no html. */
  background-color: transparent;
  /* Evita overflow horizontal causado pelas transformações das camadas animadas. */
  overflow-x: hidden;
  /* Mantém os pseudo-elementos com z-index negativo dentro do contexto do body. */
  isolation: isolate;
}

/* =========================================================
   CAMADAS DO BACKGROUND ANIMADO
   ========================================================= */

body::before,
body::after {
  content: "";
  position: fixed;

  /* Área do pseudo-elemento: reduzida de -25vmax para -15vmax.
     Como o efeito "vem de fora para dentro" (scale 4 → 0.05),
     -15vmax ainda é suficiente para cobrir a viewport durante
     toda a animação, mas reduz a alocação de buffer na GPU. */
  inset: -15vmax;
  pointer-events: none;

  /* Mantém as partículas atrás do conteúdo. */
  z-index: -1;
  transform-origin: center;

  /* `contain: strict` diz ao browser que este elemento é
     completamente isolado do resto da página — não afeta
     tamanho, layout, estilo ou pintura externa. Como é
     decorativo e não tem filhos, é seguro isolar 100%. O
     compositor usa isso para otimizar o pipeline. */
  contain: strict;

  /* Promove a camada antes do primeiro frame de animação,
     evitando um "promote on first paint" que causa micro-jank
     no início do ciclo. */
  will-change: transform, opacity;

  /* Os gradientes são repetidos para criar o campo de partículas. */
  background-repeat: repeat;

  background-image:
    radial-gradient(
      circle at 15% 45%,
      rgba(255, 200, 220, 0.8) 0,
      transparent 2px
    ),
    radial-gradient(
      circle at 60% 15%,
      rgba(255, 255, 255, 0.9) 0,
      transparent 1.5px
    ),
    radial-gradient(
      circle at 85% 75%,
      rgba(200, 180, 255, 0.8) 0,
      transparent 2px
    );

  background-size:
    16vmax 16vmax,
    24vmax 24vmax,
    20vmax 20vmax;
}

/*  Primeira camada. */
body::before {
  animation: blackhole-spin 16s linear infinite;
}

/* Segunda camada, defasada em metade do ciclo. */
body::after {
  animation: blackhole-spin 16s linear infinite;
  animation-delay: -8s;
}

/* =========================================================
   ANIMAÇÃO — INALTERADO
   ========================================================= */
@keyframes blackhole-spin {
  0% {
    transform: scale(4) rotate(30deg);
    opacity: 0;
  }

  20% {
    opacity: 1;
  }

  80% {
    opacity: 1;
  }

  100% {
    transform: scale(0.05) rotate(0deg);
    opacity: 0;
  }
}

/* =========================================================
   REDUÇÃO DE MOVIMENTO — INALTERADO
   ========================================================= */
@media (prefers-reduced-motion: reduce) {
  body::before,
  body::after {
    animation: none;
    transform: none;
    opacity: 0.35;
  }
}

/* =========================================================
   GLASSMORPHISM — blur base em desktop
   ========================================================= */

.glass-panel {
  background-color: var(--surface);

  /* Blur reduzido de 16px para 12px: visualmente quase
     idêntico, mas o custo do blur gaussiano cai
     consideravelmente em muitos engines. */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  border: 1px solid var(--border);
}

/* =========================================================
   OTIMIZAÇÃO TABLET — blur intermediário
   ========================================================= */
/* Tablets e notebooks pequenos ganham blur um degrau menor:
   mantém a sensação de vidro mas reduz o custo de paint em
   telas médias, onde a GPU costuma ser mais modesta. */

@media (max-width: 1024px) {
  .glass-panel {
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
}

/* =========================================================
   OTIMIZAÇÃO MOBILE
   ========================================================= */
@media (max-width: 768px) {
  /*
   * Remove a segunda camada no mobile.
   *
   * Isso reduz pela metade a quantidade de superfícies
   * animadas, sem eliminar completamente o efeito.
   */
  body::after {
    display: none;
  }

  /*
   * Apenas dois gradients no mobile.
   *
   * O terceiro é removido para reduzir o trabalho
   * de pintura sem comprometer o efeito visual.
   */
  body::before {
    background-image:
      radial-gradient(
        circle at 15% 45%,
        rgba(255, 200, 220, 0.75) 0,
        transparent 2px
      ),
      radial-gradient(
        circle at 75% 25%,
        rgba(220, 210, 255, 0.8) 0,
        transparent 1.5px
      );

    background-size:
      20vmax 20vmax,
      28vmax 28vmax;

    /*
     * Movimento um pouco mais suave visualmente
     * no celular.
     */
    animation-duration: 18s;
  }

  /*
   * Blur menor no mobile.
   *
   * backdrop-filter pode ser uma operação relativamente
   * cara em GPUs de celular, então o raio é reduzido
   * para 8px — o mínimo que ainda preserva a leitura
   * como "vidro" sem custo excessivo.
   */
  .glass-panel {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
}

/* =========================================================
   SCROLLBAR — INALTERADO
   ========================================================= */

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

@theme inline {
  --font-heading: var(--font-sans);
  --font-sans: var(--font-sans);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --color-foreground: var(--foreground);
  --color-background: var(--background);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

/* =========================================================
   DARK MODE — Tokens shadcn alinhados ao tema Cosmic Void
   ========================================================= */
.dark {
  /* Fundo e primeiro plano com leve matiz violeta/azulada */
  --background: oklch(0.08 0.035 285);
  --foreground: oklch(0.96 0.012 260);

  /* Cards e popovers: um degrau acima do void, ainda translúcidos */
  --card: oklch(0.14 0.04 280);
  --card-foreground: oklch(0.96 0.012 260);
  --popover: oklch(0.14 0.04 280);
  --popover-foreground: oklch(0.96 0.012 260);

  /* Primary: azul estelar (aproxima #7dd3fc em oklch) */
  --primary: oklch(0.82 0.11 220);
  --primary-foreground: oklch(0.08 0.035 285);

  /* Secundário e muted: superfícies intermediárias com tom violeta */
  --secondary: oklch(0.2 0.04 280);
  --secondary-foreground: oklch(0.96 0.012 260);
  --muted: oklch(0.2 0.04 280);
  --muted-foreground: oklch(0.7 0.04 265);
  --accent: oklch(0.2 0.04 280);
  --accent-foreground: oklch(0.96 0.012 260);

  /* Destrutivo mantido (vermelho) — contraste com a paleta fria */
  --destructive: oklch(0.704 0.191 22.216);

  /* Bordas e inputs em poeira cósmica (baixa opacidade, azulado) */
  --border: oklch(0.85 0.06 260 / 12%);
  --input: oklch(0.85 0.06 260 / 15%);
  --ring: oklch(0.6 0.08 260);

  /* Charts: uma jornada de temperatura cósmica */
  --chart-1: oklch(0.8 0.15 220); /* estelar azul */
  --chart-2: oklch(0.72 0.16 285); /* nebulosa violeta */
  --chart-3: oklch(0.75 0.19 315); /* supernova rosa */
  --chart-4: oklch(0.65 0.12 240); /* espaço profundo */
  --chart-5: oklch(0.55 0.1 270); /* poeira interestelar */

  /* Sidebar: espelha o void com tinta violeta */
  --sidebar: oklch(0.12 0.035 280);
  --sidebar-foreground: oklch(0.96 0.012 260);
  --sidebar-primary: oklch(0.82 0.11 220);
  --sidebar-primary-foreground: oklch(0.08 0.035 285);
  --sidebar-accent: oklch(0.2 0.04 280);
  --sidebar-accent-foreground: oklch(0.96 0.012 260);
  --sidebar-border: oklch(0.85 0.06 260 / 12%);
  --sidebar-ring: oklch(0.6 0.08 260);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

/* Oculta a barra de rolagem mantendo a funcionalidade de scroll */
@layer utilities {
  /* Utilitário para ocultar scrollbar em qualquer container */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none; /* IE e Edge */
    scrollbar-width: none; /* Firefox */
  }
}

/* Oculta a barra de rolagem vertical padrão em telas menores (mobile) */
@media (max-width: 768px) {
  html,
  body {
    -ms-overflow-style: none; /* IE e Edge */
    scrollbar-width: none; /* Firefox */
  }

  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none; /* Chrome, Safari e Opera */
  }
}
